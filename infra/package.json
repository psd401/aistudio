{
  "name": "infra",
  "version": "0.1.0",
  "bin": {
    "infra": "bin/infra.js"
  },
  "scripts": {
    "build": "tsc && bun run typecheck:unified-content && bun run typecheck:google-content-sync && bun run test:lambdas",
    "build:lambdas": "./build-lambdas.sh",
    "build:all": "bun run build && bun run build:lambdas",
    "watch": "tsc -w",
    "test": "jest --runInBand",
    "test:lambdas": "bun test lambdas/embedding-generator/__tests__ && cd lambdas/agent-skill-builder && bun install && bun run test",
    "typecheck:unified-content": "tsc --project lambdas/unified-content-processor/tsconfig.json",
    "typecheck:google-content-sync": "tsc --project lambdas/google-content-sync/tsconfig.json",
    "cdk": "cdk"
  },
  "devDependencies": {
    "@swc/core": "^1.16.20",
    "@swc/jest": "^0.2.39",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "26.6.6",
    "@types/pdf-parse": "^1.1.5",
    "@types/xml2js": "^0.4.14",
    "aws-cdk": "^2.1148.0",
    "jest": "^30.5.2",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2"
  },
  "dependencies": {
    "@aws-cdk/aws-amplify-alpha": "^2.209.0-alpha.0",
    "@aws-cdk/aws-bedrock-agentcore-alpha": "2.250.0-alpha.0",
    "@aws-cdk/aws-cognito": "^1.204.0",
    "@aws-cdk/aws-ec2": "^1.204.0",
    "@aws-cdk/aws-iam": "^1.204.0",
    "@aws-cdk/aws-rds": "^1.204.0",
    "@aws-cdk/aws-route53": "^1.203.0",
    "@aws-cdk/aws-s3": "^1.203.0",
    "@aws-cdk/aws-secretsmanager": "^1.203.0",
    "@aws-sdk/client-bedrock-data-automation-runtime": "^3.1160.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1160.0",
    "@aws-sdk/client-dynamodb": "^3.1160.0",
    "@aws-sdk/client-textract": "^3.1160.0",
    "@e965/xlsx": "^0.20.3",
    "@types/node-fetch": "^2.6.12",
    "aws-cdk-lib": "^2.275.0",
    "cheerio": "^1.2.0",
    "constructs": "^10.8.1",
    "csv-parse": "^7.0.3",
    "hash-wasm": "4.12.0",
    "mammoth": "^1.13.0",
    "marked": "^9.0.0",
    "node-fetch": "^3.3.2",
    "pdf-parse": "^2.4.5",
    "sharp": "^0.35.5",
    "xml2js": "^0.6.2"
  }
}
