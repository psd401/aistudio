{
  "models": {
    "providers": {
      "amazon-bedrock": {
        "baseUrl": "https://bedrock-runtime.us-east-1.amazonaws.com",
        "api": "bedrock-converse-stream",
        "auth": "aws-sdk",
        "timeoutSeconds": 300,
        "models": [
          {
            "id": "us.anthropic.claude-sonnet-5",
            "name": "Claude Sonnet 5 (Bedrock, SigV4 via execution role)",
            "reasoning": false,
            "input": ["text"],
            "contextWindow": 200000,
            "maxTokens": 32768,
            "cost": { "input": 3, "output": 15, "cacheRead": 0.3, "cacheWrite": 6 }
          }
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "amazon-bedrock/us.anthropic.claude-sonnet-5"
      },
      "bootstrapMaxChars": 32000,
      "bootstrapTotalMaxChars": 80000,
      "params": {
        "cacheRetention": "long"
      },
      "workspace": "/home/node/.openclaw",
      "contextTokens": 180000,
      "contextPruning": {
        "mode": "cache-ttl",
        "ttl": "1h"
      },
      "heartbeat": {
        "every": "0m"
      },
      "compaction": {
        "midTurnPrecheck": {
          "enabled": true
        }
      }
    }
  },
  "memory": {
    "search": {
      "provider": "bedrock",
      "model": "amazon.titan-embed-text-v2:0"
    }
  },
  "tools": {
    "toolSearch": false,
    "codeMode": {
      "timeoutMs": 60000
    },
    "web": {
      "search": {
        "enabled": true,
        "provider": "parallel-free",
        "maxResults": 5,
        "timeoutSeconds": 30,
        "cacheTtlMinutes": 15
      }
    },
    "deny": ["cron", "nodes", "gateway"]
  },
  "skills": {
    "load": {
      "extraDirs": ["/opt/psd-skills"],
      "watch": false
    }
  },
  "cron": {
    "enabled": false
  },
  "plugins": {
    "load": {
      "paths": [
        "/opt/openclaw-plugins/amazon-bedrock",
        "/opt/openclaw-plugins/parallel"
      ]
    },
    "entries": {
      "active-memory": {
        "enabled": false
      },
      "amazon-bedrock": {
        "enabled": true,
        "config": {
          "discovery": {
            "enabled": false
          }
        }
      },
      "parallel": {
        "enabled": true
      }
    }
  },
  "gateway": {
    "port": 3100,
    "mode": "local",
    "bind": "loopback",
    "trustedProxies": ["127.0.0.1"],
    "auth": {
      "mode": "token",
      "token": ""
    },
    "controlUi": {
      "enabled": false,
      "dangerouslyDisableDeviceAuth": true,
      "dangerouslyAllowHostHeaderOriginFallback": true,
      "allowedOrigins": ["*"]
    }
  }
}
